---
import { withBase } from "../utils/base";

interface Member {
  name: string;
  github?: string;
  avatar?: string;
  homepage?: string;
  roleLabel: string;
  detail: string;
  joinedAt?: string;
  newUntil?: string;
}

interface Props {
  members: Member[];
}

const { members } = Astro.props;

const resolvedMembers = members.map((member) => {
  const github = member.github?.trim();
  const avatar = member.avatar || (github ? `https://github.com/${github}.png?size=200` : "/images/RapidAIv6.png");
  const profileHref = member.homepage || (github ? `https://github.com/${github}` : undefined);
  const resolvedProfileHref = profileHref ? withBase(profileHref) : undefined;
  const opensNewTab = resolvedProfileHref !== undefined && /^(https?:)?\/\//.test(resolvedProfileHref);

  return {
    ...member,
    avatarSrc: withBase(avatar),
    github,
    profileHref: resolvedProfileHref,
    profileRel: opensNewTab ? "noreferrer" : undefined,
    profileTarget: opensNewTab ? "_blank" : undefined
  };
});
---

<div class="card-grid dynamic-member-grid">
  {
    resolvedMembers.map((member) => (
      <article class="card member-card">
        <div class="member-top">
          <img
            class="member-avatar"
            src={member.avatarSrc}
            alt={`${member.name} 头像`}
            loading="lazy"
          />
          <div class="member-badges">
            <span class="card-tag">{member.roleLabel}</span>
            {(member.joinedAt || member.newUntil) && (
              <span
                class="member-new-badge"
                data-member-joined-at={member.joinedAt}
                data-member-new-until={member.newUntil}
              >
                新加入
              </span>
            )}
          </div>
        </div>
        <div class="member-title-row">
          <h3>{member.name}</h3>
          {
            member.profileHref && (
              <a class="member-id" href={member.profileHref} target={member.profileTarget} rel={member.profileRel}>
                {member.github ? `@${member.github}` : "个人主页"}
              </a>
            )
          }
        </div>
        <p class="member-detail">{member.detail}</p>
        <div class="card-meta member-meta">
          <span>{member.github ? `@${member.github}` : "社区成员"}</span>
          {
            member.profileHref && (
              <a class="card-link" href={member.profileHref} target={member.profileTarget} rel={member.profileRel}>
                查看主页
              </a>
            )
          }
        </div>
      </article>
    ))
  }
</div>
